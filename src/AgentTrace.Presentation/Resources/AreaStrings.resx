    <comment>Title of a cell. {0} = area name, {1} = turn number, from 1.</comment>
  </data>
  <data name="MoreFiles_One" xml:space="preserve">
    <value>+{0} more file</value>
    <comment>{0}: count.</comment>
  </data>
  <data name="MoreFiles_Other" xml:space="preserve">
    <value>+{0} more files</value>
    <comment>{0}: count.</comment>
  </data>
  <data name="LegendNote" xml:space="preserve">
    <value>Double-click a row to list its files · Ctrl+wheel to zoom</value>
  </data>
</root>
